DATABASE_URL=postgresql://cadpilot:cadpilot@localhost:5432/cadpilot?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
PORT=3000
# Set NODE_ENV=production only with unique JWT secrets (32+ characters each).
NODE_ENV=development

# Server-only OpenAI configuration. Never expose this key to Flutter builds.
OPENAI_API_KEY=
OPENAI_CAD_MODEL=gpt-5.6-luna
# Integer milliseconds from 1000 to 120000; invalid values fall back to 30000.
OPENAI_TIMEOUT_MS=30000