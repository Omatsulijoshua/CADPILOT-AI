generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum SyncMutationStatus {
  PENDING
  APPLIED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  displayName   String
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   ProjectMember[]
  projects      Project[]      @relation("ProjectOwner")
  refreshTokens RefreshToken[]
  aiUsage       AiUsage[]
  providerKeys  AiProviderKey[]
  starterTemplates AiStarterTemplate[]
  syncMutations SyncMutation[]
}

enum AiProvider {
  GEMINI
  GROQ
  OPENROUTER
  OPENAI
}

model AiProviderKey {
  id          String     @id @default(uuid())
  provider    AiProvider
  label       String
  encryptedKey String
  keyHint     String
  enabled     Boolean    @default(true)
  priority    Int        @default(0)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([provider, enabled, priority])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id            String          @id @default(uuid())
  name          String
  ownerId       String
  status        ProjectStatus   @default(ACTIVE)
  revision      Int             @default(1)
  formatVersion Int             @default(1)
  manifest      Json
  contentHash   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members       ProjectMember[]
  mutations     SyncMutation[]

  @@index([ownerId, updatedAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model SyncMutation {
  id              String             @id @default(uuid())
  mutationId      String             @unique
  projectId       String
  actorUserId     String?
  baseRevision    Int
  appliedRevision Int?
  payload         Json
  status          SyncMutationStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor           User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
}

model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  projectId    String?
  provider     String
  model        String
  responseId   String?
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, projectId, createdAt])
}

model AiStarterTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  objectType  String
  promptHint  String?
  components  Json
  uses        Int      @default(1)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([objectType, uses])
  @@index([createdById, updatedAt])
}
