POSTGRES_PORT=5432
DATABASE_URL=postgresql://cadpilot:cadpilot@localhost:5432/cadpilot
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
PORT=3000
API_PORT=3000

# Required before starting the optional Docker API profile. Keep both values
# unique and at least 32 characters; do not use the example placeholders.
# CORS_ALLOWED_ORIGINS=https://cadpilot.vercel.app
# CADPILOT_SUPER_ADMIN_EMAILS=owner@example.com

# Server-only; never place this key in the tablet app.
OPENAI_API_KEY=
OPENAI_CAD_MODEL=gpt-5.6-luna
